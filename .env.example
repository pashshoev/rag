# Copy to `.env` and fill in (`.env` is gitignored):
#   cp .env.example .env

# Hugging Face token — https://huggingface.co/settings/tokens
HF_TOKEN=

# Embedding
EMBEDDING_BACKEND=in_process
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Qdrant (Compose sets http://qdrant:6333 for containers; this is for host tooling)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wikipedia

# Generation (OpenAI-compatible)
# Docker API → host Ollama: use host.docker.internal (not localhost).
# Host tooling (`make api-local`): use http://localhost:11434/v1
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2:1b
LLM_API_KEY=ollama
